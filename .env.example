HANGAR_DATA_DIR="./.data"
HANGAR_DB_HOST="./.data/app-data/hangar/hangar.db"
HANGAR_STORE_URL="https://github.com/you/your-hangar-store.git"

DOMAIN="example.com"

# Better Auth
BETTER_AUTH_URL="http://localhost:3010"
BETTER_AUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"

# The Rust server's sign-in: the page's URL, Vite's under `cargo quoll dev`, and the cookies' secret
HANGAR_URL="http://localhost:5173"
HANGAR_SECRET="change-me-generate-with-openssl-rand-base64-32"

# The Rust server's identity provider, if any (its callback is $HANGAR_URL/api/auth/oidc/callback)
# HANGAR_OIDC_ISSUER="https://auth.example.com/application/o/hangar/"
# HANGAR_OIDC_CLIENT_ID="hangar"
# HANGAR_OIDC_CLIENT_SECRET="…"

# Host terminal: the host it signs in to over SSH (port 22 unless HANGAR_SSH_PORT says otherwise)
# HANGAR_SSH_HOST="host.docker.internal"
# HANGAR_SSH_USER="you"
