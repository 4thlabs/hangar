{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // oxlint's default plugins. Its React rules stay off: ESLint runs React's own plugin, and a rule is in one tool.
  "categories": { "correctness": "error" },
  "options": { "typeAware": true, "denyWarnings": true },
  "ignorePatterns": ["src/libs/api/generated.ts", "src/modules/common/ui/**"],
  "rules": {
    "no-unused-vars": "error",
    "typescript/await-thenable": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/prefer-promise-reject-errors": "error",
    "typescript/switch-exhaustiveness-check": "error",
    // Off until #195: it reads a static member passed by reference, as `apps.map(ComposeOutput.waiting)`, as a method
    // that loses its `this`. #195 turns those classes into module functions, and turns the rule back on.
    "typescript/unbound-method": "off"
  }
}
