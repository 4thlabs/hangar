{
  "name": "hangar-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "imports": {
    "#libs/*": "./src/libs/*/index.ts",
    "#paraglide/*": "./src/paraglide/*",
    "#*": "./src/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "paraglide-js compile --silent && tsr generate && tsc --noEmit && vite build",
    "test": "vitest run",
    "lint": "paraglide-js compile --silent && tsr generate && oxlint",
    "typecheck": "paraglide-js compile --silent && tsr generate && tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@codemirror/commands": "^6.11.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.44.1",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.108.4",
    "@tanstack/react-router": "^1.170.46",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "codemirror": "^6.0.2",
    "cookie": "^2.0.2",
    "fuzzysort": "^4.0.2",
    "lucide-react": "^1.41.0",
    "react": "~19.3.0",
    "react-dom": "~19.3.0",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@inlang/paraglide-js": "3.2.2",
    "@inlang/plugin-message-format": "4.6.2",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/intent": "0.5.6",
    "@tanstack/router-cli": "^1.168.0",
    "@tanstack/router-plugin": "^1.169.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eventsource": "^5.1.5",
    "happy-dom": "^21.0.4",
    "msw": "^3.0.8",
    "orval": "^8.49.0",
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "7.0.2008",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.1.1"
  },
  "intent": {
    "skills": [
      "@tanstack/react-router",
      "@tanstack/router-core",
      "@tanstack/router-plugin"
    ]
  }
}
