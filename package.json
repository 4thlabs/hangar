{
  "name": "hangar",
  "version": "0.2.0",
  "type": "module",
  "private": true,
  "imports": {
    "#libs/docker/*": "./src/libs/docker/*",
    "#libs/widgets/*": "./src/libs/widgets/*",
    "#libs/*": "./src/libs/*/index.ts",
    "#*": "./src/*"
  },
  "scripts": {
    "dev": "waku dev --port 3010",
    "build": "HANGAR_DB_HOST=:memory: waku build",
    "start": "waku start --port 3010",
    "typegen": "waku router typegen",
    "db:pull": "drizzle-kit pull",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node src/libs/db/utils/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@better-auth/drizzle-adapter": "^1.7.3",
    "@sidequest/sqlite-backend": "^1.16.4",
    "better-auth": "^1.7.3",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "commander": "^15.0.0",
    "cookie": "^2.0.1",
    "dockerode": "^5.0.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^1.0.0-rc.4",
    "fuzzysort": "^4.0.2",
    "hono": "^4.12.14",
    "jotai": "^3.0.0",
    "js-yaml": "^5.4.1",
    "ky": "^2.1.0",
    "lucide-react": "^1.41.0",
    "prettier": "^3.9.6",
    "react": "~19.2.8",
    "react-dom": "~19.2.8",
    "react-server-dom-webpack": "~19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sidequest": "^1.16.4",
    "tw-animate-css": "^1.4.0",
    "waku": "1.0.0-rc.0",
    "waku-cache": "^0.0.1",
    "winston": "^3.19.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/dockerode": "^4.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^1.0.0-rc.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "esbuild@0.25.12": true,
    "cpu-features@0.0.10": true,
    "protobufjs@7.6.6": true,
    "ssh2@1.17.0": true,
    "better-sqlite3@12.11.1": true
  }
}
