{
  "components": {
    "responses": {
      "BadRequest": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "A parameter or the body is missing, or does not read as its type."
      },
      "Problem": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "An error, as an RFC 9457 problem."
      },
      "Unauthorized": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "The request carries no valid credential of a scheme the route takes.",
        "headers": {
          "WWW-Authenticate": {
            "description": "A challenge per scheme the route takes, in the order it takes them.",
            "schema": {
              "type": "string"
            }
          }
        }
      },
      "UnsupportedMediaType": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "The body does not have the content type the route reads."
      }
    },
    "schemas": {
      "AppCounts": {
        "description": "How many of the store's apps each filter keeps.",
        "properties": {
          "available": {
            "description": "The apps not installed.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "installed": {
            "description": "The apps installed.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "installed",
          "available"
        ],
        "type": "object"
      },
      "AppFilter": {
        "description": "Which of the store's apps a listing keeps.",
        "oneOf": [
          {
            "const": "installed",
            "description": "The apps linked into `app-installed/`.",
            "type": "string"
          },
          {
            "const": "available",
            "description": "The apps that are not.",
            "type": "string"
          }
        ]
      },
      "ConfigSource": {
        "description": "`hangar.yml` as it is written.",
        "properties": {
          "source": {
            "description": "The file, empty when the store ships none.",
            "type": "string"
          }
        },
        "required": [
          "source"
        ],
        "type": "object"
      },
      "Credentials": {
        "description": "The email and the password of a user of `hangar.yml`.",
        "properties": {
          "email": {
            "description": "The user's email, whatever its case.",
            "type": "string"
          },
          "password": {
            "description": "The password.",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "type": "object"
      },
      "EnvChanges": {
        "description": "What a save changes in `.env.global`: the variables it sets, and the ones it removes, the only way one is lost.",
        "properties": {
          "remove": {
            "default": [],
            "description": "The variables to remove.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "updates": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "The variables to set, by name: added, or their value replaced.",
            "type": "object"
          }
        },
        "required": [
          "updates"
        ],
        "type": "object"
      },
      "ErrorDetail": {
        "description": "An error as a body carries it, where a problem does not: its code, its params, and its English message, which the\npage shows until a catalog words the code.\n\n```\nuse hangar_api::{ErrorCode, ErrorDetail};\n\nlet detail = ErrorDetail::from(ErrorCode::UnknownApp { app: \"alpha\".to_owned() });\n\nassert_eq!(\n    serde_json::to_value(&detail).expect(\"JSON\"),\n    serde_json::json!({\n        \"code\": \"store.unknown_app\",\n        \"params\": { \"app\": \"alpha\" },\n        \"message\": \"the store has no app alpha\",\n    })\n);\n```",
        "oneOf": [
          {
            "description": "The store carries no app of this id.",
            "properties": {
              "code": {
                "const": "store.unknown_app",
                "type": "string"
              },
              "params": {
                "properties": {
                  "app": {
                    "description": "The id asked for.",
                    "type": "string"
                  }
                },
                "required": [
                  "app"
                ],
                "type": "object"
              }
            },
            "required": [
              "code",
              "params"
            ],
            "type": "object"
          },
          {
            "description": "The store's apps could not be listed.",
            "properties": {
              "code": {
                "const": "store.apps_unreadable",
                "type": "string"
              }
            },
            "required": [
              "code"
            ],
            "type": "object"
          },
          {
            "description": "An app could not be installed.",
            "properties": {
              "code": {
                "const": "store.install_failed",
                "type": "string"
              },
              "params": {
                "properties": {
                  "app": {
                    "description": "The app's display name.",
                    "type": "string"
                  }
                },
                "required": [
                  "app"
                ],
                "type": "object"
              }
            },
            "required": [
              "code",
              "params"
            ],
            "type": "object"
          },
          {
            "description": "An app could not be uninstalled: `docker compose down` failed, or its link could not be removed.",
            "properties": {
              "code": {
                "const": "store.uninstall_failed",
                "type": "string"
              },
              "params": {
                "properties": {
                  "app": {
                    "description": "The app's display name.",
                    "type": "string"
                  }
                },
                "required": [
                  "app"
                ],
                "type": "object"
              }
            },
            "required": [
              "code",
              "params"
            ],
            "type": "object"
          },
          {
            "description": "The store's clone failed.",
            "properties": {
              "code": {
                "const": "store.clone_failed",
                "type": "string"
              }
            },
            "required": [
              "code"
            ],
            "type": "object"
          },
          {
            "description": "The store's pull failed: git could not reach it, or a change of the clone, to `hangar.yml` say, is in the way.",
            "properties": {
              "code": {
                "const": "store.pull_failed",
                "type": "string"
              }
            },
            "required": [
              "code"
            ],
            "type": "object"
          },
          {
            "description": "The store is not cloned yet, which this needs.",
            "properties": {
              "code": {
                "const": "store.not_installed",
                "type": "string"
              }
            },
            "required": [
              "code"
            ],
            "type": "object"
          },
          {
            "description": "`hangar.yml` is not YAML, holds no document, or several.",
            "properties": {
              "code": {
                "const": "config.syntax",
                "type": "string"
              },
              "params": {
                "properties": {
                  "reason": {
                    "description": "What the YAML parser says, in English.",
                    "type": "string"
                  }
                },
                "required": [
                  "reason"
                ],
                "type": "object"
              }
            },
            "required": [
              "code",
              "params"
            ],
            "type": "object"
          },
          {
            "description": "`hangar.yml` does not follow its rules.",
            "properties": {
              "code": {
                "const": "config.invalid",
                "type": "string"
              },
              "params": {
                "properties": {
                  "field": {
                    "description": "The path of the field at fault, as `categories[0].color`; `.` for the whole file.",
                    "type": "string"
                  },
                  "reason": {
                    "description": "What is wrong with it, in English.",
                    "type": "string"
                  }
                },
                "required": [
                  "field",
                  "reason"
                ],
                "type": "object"
              }
            },
            "required": [
              "code",
              "params"
            ],
            "type": "object"
          },
          {
            "description": "`hangar.yml` could not be read.",
            "properties": {
              "code": {
                "const": "config.unreadable",
                "type": "string"
              }
            },
            "required": [
              "code"
            ],
            "type": "object"
          },
          {
            "description": "`hangar.yml` could not be written.",
            "properties": {
              "code": {
                "const": "config.save_failed",
                "type": "string"
              }
            },
            "required": [
              "code"
            ],
            "type": "object"
          },
          {
            "description": "A name compose does not take as a variable's.",
            "properties": {
              "code": {
                "const": "env.invalid_name",
                "type": "string"
              },
              "params": {
                "properties": {
                  "name": {
                    "description": "The name.",
                    "type": "string"
                  }
                },
                "required": [
                  "name"
                ],
                "type": "object"
              }
            },
            "required": [
              "code",
              "params"
            ],
            "type": "object"
          },
          {
            "description": "A value with a line break, which would add a variable to the file.",
            "properties": {
              "code": {
                "const": "env.line_break",
                "type": "string"
              },
              "params": {
                "properties": {
                  "name": {
                    "description": "The variable.",
                    "type": "string"
                  }
                },
                "required": [
                  "name"
                ],
                "type": "object"
              }
            },
            "required": [
              "code",
              "params"
            ],
            "type": "object"
          },
          {
            "description": "A value that no quoting writes so that it reads back the same.",
            "properties": {
              "code": {
                "const": "env.unwritable_value",
                "type": "string"
              },
              "params": {
                "properties": {
                  "name": {
                    "description": "The variable.",
                    "type": "string"
                  }
                },
                "required": [
                  "name"
                ],
                "type": "object"
              }
            },
            "required": [
              "code",
              "params"
            ],
            "type": "object"
          },
          {
            "description": "`.env.global` could not be read.",
            "properties": {
              "code": {
                "const": "env.unreadable",
                "type": "string"
              }
            },
            "required": [
              "code"
            ],
            "type": "object"
          },
          {
            "description": "`.env.global` could not be copied aside or written.",
            "properties": {
              "code": {
                "const": "env.save_failed",
                "type": "string"
              }
            },
            "required": [
              "code"
            ],
            "type": "object"
          },
          {
            "description": "A save that both sets and removes a variable.",
            "properties": {
              "code": {
                "const": "env.updated_and_removed",
                "type": "string"
              },
              "params": {
                "properties": {
                  "name": {
                    "description": "The variable.",
                    "type": "string"
                  }
                },
                "required": [
                  "name"
                ],
                "type": "object"
              }
            },
            "required": [
              "code",
              "params"
            ],
            "type": "object"
          },
          {
            "description": "A sync of the store runs, which a change of the store waits for the end of.",
            "properties": {
              "code": {
                "const": "store.sync_running",
                "type": "string"
              }
            },
            "required": [
              "code"
            ],
            "type": "object"
          },
          {
            "description": "The sync of the store stopped short: the server failed it, and its log says how.",
            "properties": {
              "code": {
                "const": "store.sync_crashed",
                "type": "string"
              }
            },
            "required": [
              "code"
            ],
            "type": "object"
          }
        ],
        "properties": {
          "message": {
            "description": "The code's English message.",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      },
      "GlobalVariables": {
        "description": "The variables of `.env.global`, by name. Their values are secrets as often as not: the answer is never cached.",
        "properties": {
          "variables": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Each variable's value, sorted by name.",
            "type": "object"
          }
        },
        "required": [
          "variables"
        ],
        "type": "object"
      },
      "NewAppTemplate": {
        "description": "What a new app starts from: its `compose.yml`.",
        "properties": {
          "compose": {
            "description": "The `compose.yml`: a name, an icon, and a service with its container, what Hangar needs to list the app.",
            "type": "string"
          }
        },
        "required": [
          "compose"
        ],
        "type": "object"
      },
      "Problem": {
        "description": "An RFC 9457 problem: what went wrong with a request, the body of every error, as `application/problem+json`.",
        "properties": {
          "detail": {
            "description": "What went wrong with this request.",
            "type": "string"
          },
          "instance": {
            "description": "A URI naming this occurrence of the problem.",
            "format": "uri-reference",
            "type": "string"
          },
          "status": {
            "description": "The status of the answer.",
            "maximum": 599,
            "minimum": 100,
            "type": "integer"
          },
          "title": {
            "description": "A short summary of the kind of problem.",
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "description": "A URI naming the kind of problem: `about:blank` for a problem that says no more than its status.",
            "format": "uri-reference",
            "type": "string"
          }
        },
        "type": "object"
      },
      "ServerHealth": {
        "description": "What the health route answers: the server is up, at this version.",
        "properties": {
          "version": {
            "description": "The version of the server, as its crates give it.",
            "type": "string"
          }
        },
        "required": [
          "version"
        ],
        "type": "object"
      },
      "SessionUser": {
        "description": "The user a session is for.",
        "properties": {
          "email": {
            "description": "The user's email, as `hangar.yml` writes it.",
            "type": "string"
          },
          "name": {
            "description": "The name `hangar.yml` gives the user.",
            "type": "string"
          }
        },
        "required": [
          "name",
          "email"
        ],
        "type": "object"
      },
      "SignInOptions": {
        "description": "What the sign-in page offers.",
        "properties": {
          "oidc": {
            "description": "Whether an OpenID Connect provider is configured: the page then offers to sign in with it.",
            "type": "boolean"
          }
        },
        "required": [
          "oidc"
        ],
        "type": "object"
      },
      "StoreApp": {
        "description": "An app of the store, installed or not.",
        "properties": {
          "icon": {
            "description": "The URL of its icon, `x-hangar.icon`.",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "description": "Its id: its folder under `store/`, and its compose project.",
            "type": "string"
          },
          "installed": {
            "description": "Whether it is installed.",
            "type": "boolean"
          },
          "name": {
            "description": "Its display name: `x-hangar.name`, else the compose file's `name`, else its id capitalized.",
            "type": "string"
          },
          "swarmReady": {
            "description": "Whether it ships a `compose.swarm.yml` with content, and can then be deployed in the swarm.",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "icon",
          "installed",
          "swarmReady"
        ],
        "type": "object"
      },
      "StoreApps": {
        "description": "The apps a listing keeps, and how many apps each filter would keep.",
        "properties": {
          "apps": {
            "description": "The apps the filters keep, by id.",
            "items": {
              "$ref": "#/components/schemas/StoreApp"
            },
            "type": "array"
          },
          "counts": {
            "allOf": [
              {
                "$ref": "#/components/schemas/AppCounts"
              }
            ],
            "description": "How many of all the store's apps each filter keeps, whatever the filters asked."
          }
        },
        "required": [
          "apps",
          "counts"
        ],
        "type": "object"
      },
      "StoreStatus": {
        "description": "The store as the settings show it: where it comes from, whether it is cloned, and its last sync.",
        "properties": {
          "installed": {
            "description": "Whether the store's repository is cloned in the data directory.",
            "type": "boolean"
          },
          "sync": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/StoreSync"
              },
              {
                "type": "null"
              }
            ],
            "description": "The last sync since the server started, running or ended; `None` before the first."
          },
          "url": {
            "description": "The git URL of the store, `HANGAR_STORE_URL`.",
            "type": "string"
          }
        },
        "required": [
          "url",
          "installed",
          "sync"
        ],
        "type": "object"
      },
      "StoreSync": {
        "description": "A clone or a pull of the store, which runs apart from the request that starts it, one at a time.",
        "properties": {
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorDetail"
              },
              {
                "type": "null"
              }
            ],
            "description": "Why it failed, as a code and its params beside its English message, without git's output, which the server's\nlog holds; `None` unless it failed."
          },
          "finishedAt": {
            "description": "When it ended, in RFC 3339; `None` while it runs.",
            "type": [
              "string",
              "null"
            ]
          },
          "operation": {
            "allOf": [
              {
                "$ref": "#/components/schemas/SyncOperation"
              }
            ],
            "description": "A clone, for a store not cloned yet, or a pull with `--ff-only`."
          },
          "startedAt": {
            "description": "When it started, in RFC 3339.",
            "type": "string"
          },
          "state": {
            "allOf": [
              {
                "$ref": "#/components/schemas/SyncState"
              }
            ],
            "description": "Where it is."
          }
        },
        "required": [
          "operation",
          "state",
          "startedAt",
          "finishedAt",
          "error"
        ],
        "type": "object"
      },
      "SyncOperation": {
        "description": "What a sync does.",
        "oneOf": [
          {
            "const": "install",
            "description": "Clones the store, which is not there yet.",
            "type": "string"
          },
          {
            "const": "update",
            "description": "Pulls the store, with `--ff-only`.",
            "type": "string"
          }
        ]
      },
      "SyncState": {
        "description": "Where a sync is.",
        "oneOf": [
          {
            "const": "running",
            "description": "It runs.",
            "type": "string"
          },
          {
            "const": "succeeded",
            "description": "It ended well: the apps `hangar.yml` lists are linked, and `.env.global` seeded.",
            "type": "string"
          },
          {
            "const": "failed",
            "description": "It failed: its `error` says why.",
            "type": "string"
          }
        ]
      }
    },
    "securitySchemes": {
      "OidcFlow": {
        "description": "The sign-in through the provider, from its start to its callback: a cookie the server encrypts, which holds the state, the nonce and the PKCE verifier for ten minutes. Over plain HTTP, it is `hangar-oidc`.",
        "in": "cookie",
        "name": "__Host-hangar-oidc",
        "type": "apiKey"
      },
      "Session": {
        "description": "The session of the page: a cookie the server signs, `HttpOnly` and `SameSite=Lax`. Over plain HTTP, where a browser keeps no `Secure` cookie, it is `hangar-session`, neither `Secure` nor `__Host-`.",
        "in": "cookie",
        "name": "__Host-hangar-session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Hangar's API, which its page calls. Every error is a problem, in English. Every route but those of `Auth` and\n`Health` takes a `Session`.",
    "title": "hangar-api",
    "version": "0.1.0"
  },
  "openapi": "3.1.1",
  "paths": {
    "/api/auth/login": {
      "post": {
        "operationId": "auth_login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionUser"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "summary": "Signs in a user of `hangar.yml` by password, and sets the session's cookie. A wrong email or password is a 401, and too many of them for one email a 429.",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/auth/logout": {
      "post": {
        "operationId": "auth_logout",
        "responses": {
          "204": {
            "description": "No Content"
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "summary": "Signs out: the session's cookie is cleared.",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/auth/oidc/callback": {
      "get": {
        "operationId": "auth_oidc_callback",
        "parameters": [
          {
            "description": "The code to exchange for the tokens.",
            "in": "query",
            "name": "code",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The provider's error, as `access_denied` when the user declines.",
            "in": "query",
            "name": "error",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The state the sign-in sent the provider, which must come back as it went.",
            "in": "query",
            "name": "state",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "security": [
          {
            "OidcFlow": []
          },
          {}
        ],
        "summary": "Where the provider sends the browser back: the session's cookie for a user `hangar.yml` lists, by its subject or its verified email, and a redirect to the page; any other is sent back to `/login` with an `error` that says why.",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/auth/oidc/login": {
      "get": {
        "operationId": "auth_oidc_login",
        "responses": {
          "204": {
            "description": "No Content"
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "summary": "Starts a sign-in through the provider: a redirect to it, with the flow's cookie. A 404 when no provider is configured.",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/auth/options": {
      "get": {
        "operationId": "auth_options",
